# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN GOWORK=off go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOWORK=off \
    go build -trimpath -ldflags="-s -w" -o /out/harness-gateway ./cmd/harness-gateway

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 65532 gateway \
    && adduser -S -D -H -u 65532 -G gateway gateway
WORKDIR /app
RUN mkdir -p /var/lib/harness-gateway/private \
    && chown -R 65532:65532 /var/lib/harness-gateway
COPY --from=build --chown=65532:65532 /out/harness-gateway /app/harness-gateway
USER 65532:65532
ENV HARNESS_GATEWAY_ADDR=0.0.0.0:8082 \
    HARNESS_GATEWAY_DB_DRIVER=postgres
EXPOSE 8082
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --spider http://127.0.0.1:8082/gateway/v1/ready || exit 1
ENTRYPOINT ["/app/harness-gateway"]
