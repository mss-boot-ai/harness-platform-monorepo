[Unit]
Description=Harness Gateway loopback bridge for ABA
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=harness-port-forward
Group=harness-port-forward
Environment=HARNESS_KUBE_NAMESPACE=harness-dev
Environment=HARNESS_GATEWAY_POD=harness-gateway-0
Environment=HARNESS_GATEWAY_LOCAL_PORT=18082
Environment=HARNESS_GATEWAY_REMOTE_PORT=8082
Environment=HOME=/run/harness-gateway-port-forward
EnvironmentFile=/etc/harness-aba/port-forward.env
ExecStart=/opt/harness/bin/harness-gateway-port-forward
Restart=always
RestartSec=3s
UMask=0077
RuntimeDirectory=harness-gateway-port-forward
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
CPUQuota=100%
LimitNOFILE=1024
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
