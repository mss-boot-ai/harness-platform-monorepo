[Unit]
Description=Harness acp-brige-agent
Requires=harness-gateway-port-forward.service
After=network-online.target harness-gateway-port-forward.service

[Service]
Type=simple
User=harness-aba
Group=harness-aba
WorkingDirectory=/var/lib/harness-aba
Environment=HOME=/var/lib/harness-aba
Environment=PATH=/opt/harness/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/harness-aba/runtime.env
ExecStart=/opt/harness/bin/acp-brige-agent run --config /etc/harness-aba/aba.toml --store /var/lib/harness-aba/identity.json --insecure-dev-keystore
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
StateDirectory=harness-aba
StateDirectoryMode=0700
ConfigurationDirectory=harness-aba
ConfigurationDirectoryMode=0750
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/harness-aba /srv/harness-workspaces/harness-platform
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
CPUQuota=400%
LimitNOFILE=8192
MemoryMax=4G
TasksMax=256

[Install]
WantedBy=multi-user.target
