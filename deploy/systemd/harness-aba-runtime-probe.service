[Unit]
Description=Probe the Harness DeepSeek ACP runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=harness-aba
Group=harness-aba
WorkingDirectory=/var/lib/harness-aba
Environment=HOME=/var/lib/harness-aba
Environment=PATH=/opt/harness/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/harness-aba/runtime.env
ExecStart=/opt/harness/bin/acp-brige-agent runtime probe --config /etc/harness-aba/aba.toml --runtime deepseek-harness --workspace harness-platform --insecure-loopback-development
UMask=0077
StateDirectory=harness-aba
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/harness-aba /srv/harness-workspaces/harness-platform
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
CPUQuota=400%
LimitNOFILE=8192
LimitCORE=0
MemoryMax=4G
TasksMax=256
