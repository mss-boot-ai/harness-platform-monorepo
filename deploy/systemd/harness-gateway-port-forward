#!/usr/bin/env bash
set -Eeuo pipefail

harness_namespace="${HARNESS_KUBE_NAMESPACE:-harness-dev}"
harness_pod="${HARNESS_GATEWAY_POD:-harness-gateway-0}"
harness_local_port="${HARNESS_GATEWAY_LOCAL_PORT:-18082}"
harness_remote_port="${HARNESS_GATEWAY_REMOTE_PORT:-8082}"
harness_context="${HARNESS_KUBE_CONTEXT:-}"
harness_kubeconfig="${KUBECONFIG:-}"

[[ "${harness_namespace}" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] || exit 2
[[ "${harness_pod}" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] || exit 2
[[ "${harness_local_port}" =~ ^[0-9]{2,5}$ ]] || exit 2
[[ "${harness_remote_port}" =~ ^[0-9]{2,5}$ ]] || exit 2
(( harness_local_port >= 1024 && harness_local_port <= 65535 )) || exit 2
(( harness_remote_port >= 1 && harness_remote_port <= 65535 )) || exit 2
if [[ -z "${harness_context}" || "${harness_kubeconfig}" != /* || ! -r "${harness_kubeconfig}" ]]; then
  echo "error: a readable absolute KUBECONFIG and explicit HARNESS_KUBE_CONTEXT are required" >&2
  exit 2
fi

if command -v kubectl >/dev/null 2>&1; then
  exec kubectl --kubeconfig "${harness_kubeconfig}" --context "${harness_context}" \
    -n "${harness_namespace}" port-forward --address=127.0.0.1 \
    "pod/${harness_pod}" "${harness_local_port}:${harness_remote_port}"
fi

echo "error: kubectl is unavailable" >&2
exit 2
